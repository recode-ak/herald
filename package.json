{
  "name": "herald",
  "version": "0.1.0",
  "description": "Посредник между ИИ-агентами и человеком через Telegram",
  "license": "MIT-0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "lint": "bunx biome check .",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "link": "mkdir -p ~/.local/bin && ln -sf \"$PWD/src/cli/main.ts\" ~/.local/bin/herald && echo \"herald → ~/.local/bin/herald\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
